---
import BuiltFor from "../components/BuiltFor.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Footer from "../components/Footer.astro";
import HeroCover from "../components/HeroCover.astro";
import OttoFeatureIntro from "../components/OttoFeatureIntro.astro";
import OttoSection from "../components/OttoSection.astro";
import ReportTypes from "../components/ReportTypes.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../site";

const description = site.heroSubcopy;
---

<Layout title="Home" description={description}>
  <main>
    <HeroCover />
    <OttoFeatureIntro />
    <ReportTypes />
    <OttoSection />
    <BuiltFor />
    <DemoBanner />
  </main>
  <Footer />
</Layout>
