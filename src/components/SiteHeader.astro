---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
---

<header class="site-header sticky top-0 z-50 w-full">
  <div class="site-header__inner">
    <a href="/" class="inline-block shrink-0">
      <img
        src={site.logos.company}
        alt={site.name}
        class="site-header__logo max-w-[min(100%,20rem)]"
        width={165}
        height={40}
        loading="eager"
      />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <div class="site-header__links">
        <a href={site.cta.login.href} class="nav-link">
          {site.cta.login.label}
        </a>
      </div>
      <CtaButton
        class="site-header__cta"
        href={site.cta.primary.href}
        label={site.cta.primary.label}
        size="nav"
        newTab={site.cta.primary.newTab}
      />
    </nav>

    <details class="relative ml-auto md:hidden">
      <summary
        class="flex size-7 list-none items-center justify-center text-type [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <div
        class="absolute right-0 top-[calc(100%+0.5rem)] flex min-w-[12rem] flex-col gap-4 rounded-lg border border-type/10 bg-field p-4 shadow-lg"
      >
        <a href={site.cta.login.href} class="nav-link">
          {site.cta.login.label}
        </a>
        <CtaButton
          href={site.cta.primary.href}
          label={site.cta.primary.label}
          size="nav"
          newTab={site.cta.primary.newTab}
        />
      </div>
    </details>
  </div>
</header>
