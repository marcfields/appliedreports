---
import { site } from "../site";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";

const { reportTypesSection: section } = site;
---

<SectionPanel id="reports" panelClass="bg-paper text-type" aria-labelledby="reports-heading">
  <SectionShell>
    <h2 id="reports-heading" class="heading-h2 text-type">
      {section.heading}
    </h2>
    <hr class="section-divider" />
    <p class="section-lead text-type">
      {section.body}
    </p>

    <ul class="section-content report-types-grid">
      {
        section.items.map((item) => (
          <li class="report-type-card">
            <img
              src={item.icon}
              alt=""
              class="size-[9.375rem] object-contain"
              width={150}
              height={150}
              loading="lazy"
            />
            <p class="table-body whitespace-pre-line text-type">
              {item.label}
            </p>
          </li>
        ))
      }
    </ul>
  </SectionShell>
</SectionPanel>
