---
import { site } from "../site";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";

const { reportTypesSection: section } = site;
---

<SectionPanel id="reports" align="left" panelClass="bg-paper text-type" aria-labelledby="reports-heading">
  <SectionShell>
    <h2 id="reports-heading" class="heading-h2 text-type">
      {section.heading}
    </h2>
    <hr class="section-divider" />
    <p class="table-body mt-8 max-w-[76rem] text-type">
      {section.body}
    </p>

    <ul class="section-content grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-6">
      {
        section.items.map((item) => (
          <li class="flex flex-col items-center text-center">
            <img
              src={item.icon}
              alt=""
              class="size-[9.375rem] object-contain"
              width={150}
              height={150}
              loading="lazy"
            />
            <p class="table-body mt-4 text-type whitespace-pre-line">
              {item.label}
            </p>
          </li>
        ))
      }
    </ul>
  </SectionShell>
</SectionPanel>
