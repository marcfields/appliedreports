---
import { Image } from "astro:assets";
import { site } from "../site";
import SectionShell from "./SectionShell.astro";
import ottoProductDemo from "../assets/otto-product-demo.png";

const { ottoFeatureIntro: section } = site;
---

<section class="bg-type text-paper" aria-labelledby="otto-feature-heading">
  <SectionShell>
    <h2 id="otto-feature-heading" class="heading-h2">
      {section.heading}
    </h2>
    <hr class="section-divider-light" />
    <p class="section-lead">
      {section.bodyBefore}
      <strong class="font-bold">{section.bodyBold}</strong>
    </p>
    <div class="section-content flex justify-center">
      <Image
        src={ottoProductDemo}
        alt="Otto in Microsoft Word showing site photos, notes, and writing suggestions"
        class="w-full max-w-[66rem] rounded-[1.2rem]"
        widths={[1062, 800, 600]}
        sizes="(max-width: 66rem) 100vw, 66rem"
        loading="lazy"
        decoding="async"
      />
    </div>
  </SectionShell>
</section>
