---
import { Image } from "astro:assets";
import { site } from "../site";
import ottoProductDemo from "../assets/otto-product-demo.png";

const { ottoFeatureIntro: section } = site;
---

<section class="bg-type text-paper" aria-labelledby="otto-feature-heading">
  <div class="mx-auto max-w-[87rem] px-6 py-16 sm:px-10 sm:py-20 lg:px-[6.5rem] lg:py-24">
    <h2
      id="otto-feature-heading"
      class="max-w-[76rem] font-display text-[clamp(2rem,5vw,3.75rem)] font-bold leading-[1.4]"
    >
      {section.heading}
    </h2>
    <hr class="mt-8 border-0 border-t border-paper/25" />
    <p class="mt-8 max-w-[76rem] font-sans text-[1.375rem] leading-[1.4]">
      {section.bodyBefore}
      <strong class="font-bold">{section.bodyBold}</strong>
    </p>
    <div class="mt-12 flex justify-center lg:mt-16">
      <Image
        src={ottoProductDemo}
        alt="Otto in Microsoft Word showing site photos, notes, and writing suggestions"
        class="w-full max-w-[66rem] rounded-[1.2rem]"
        widths={[1062, 800, 600]}
        sizes="(max-width: 66rem) 100vw, 66rem"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
