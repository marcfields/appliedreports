---
import { site } from "../site";

interface Props {
  href: string;
  label: string;
  variant?: "mark" | "field" | "paper";
  size?: "default" | "nav";
  class?: string;
  newTab?: boolean;
}

const { href, label, variant = "mark", size = "default", class: className = "", newTab = false } =
  Astro.props;

const variants = {
  mark: "bg-mark text-paper hover:bg-mark/90",
  field: "bg-field text-type hover:bg-field/90",
  paper: "bg-paper text-type hover:bg-paper/90",
};

const isNav = size === "nav";
---

<a
  href={href}
  class:list={["btn", isNav && "btn--nav", variants[variant], className]}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
>
  {label}
</a>
