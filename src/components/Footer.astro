---
import { site } from "../site";

const { footer } = site;
---

<footer class="footer">
  <img
    src={site.images.footer}
    alt=""
    class="footer__photo"
    width={1440}
    height={787}
    loading="lazy"
  />

  <div class="footer__content">
    <div class="footer__brand">
      <img
        src={site.logos.arc}
        alt={site.name}
        class="footer__logo"
        width={footer.logoWidthPx}
        height={footer.logoHeightPx}
        loading="lazy"
      />

      <ul class="footer__links" aria-label="Footer">
        <li class="footer__link-item footer__link-item--start">
          <a
            href={site.url}
            class="footer__link transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
          >
            appliedreports.com
          </a>
        </li>
        <li class="footer__link-item footer__link-item--center">
          <a
            href={`mailto:${site.contactEmail}`}
            class="footer__link transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
          >
            hello@appliedreports.com
          </a>
        </li>
        <li class="footer__link-item footer__link-item--end">
          <p class="footer__link">
            © {site.year} {footer.copyrightName}
          </p>
        </li>
      </ul>
    </div>
  </div>
</footer>
