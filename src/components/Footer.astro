---
import { site } from "../site";

const { footer } = site;
---

<footer class="footer">
  <img
    src={site.images.footer}
    alt=""
    class="footer__photo"
    width={1440}
    height={787}
    loading="lazy"
  />

  <div class="footer__content">
    <div class="footer__brand">
      <img
        src={site.logos.arc}
        alt={site.name}
        class="footer__logo"
        width={footer.logoWidthPx}
        height={footer.logoHeightPx}
        loading="lazy"
      />

      <ul class="footer__links" aria-label="Footer">
        {
          footer.links.map((item) => (
            <li
              class:list={[
                "footer__link-item",
                item.align === "start" && "footer__link-item--start",
                item.align === "center" && "footer__link-item--center",
                item.align === "end" && "footer__link-item--end",
              ]}
            >
              {item.kind === "link" ? (
                <a
                  href={item.href}
                  class="footer__link transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
                >
                  {item.label}
                </a>
              ) : (
                <p class="footer__link">{item.label}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
