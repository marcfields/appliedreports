---
import { site } from "../site";

const { footer } = site;
const siteHref = site.url;
const emailHref = `mailto:${site.contactEmail}`;
---

<footer class="footer">
  <img
    src={site.images.footer}
    alt=""
    class="footer__photo"
    width={1440}
    height={787}
    loading="lazy"
  />
  <div class="footer__scrim" aria-hidden="true"></div>

  <div class="footer__content">
    <img
      src={site.logos.arc}
      alt={site.name}
      class="footer__logo"
      width={1106}
      height={134}
      loading="lazy"
    />

    <nav class="footer__links" aria-label="Footer">
      <a
        href={siteHref}
        class="footer__link transition hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
      >
        {footer.siteLabel}
      </a>
      <a
        href={emailHref}
        class="footer__link transition hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
      >
        {footer.emailLabel}
      </a>
      <p class="footer__link">
        <span aria-hidden="true">© </span>
        {site.year}
        {" "}
        {footer.copyrightName}
      </p>
    </nav>
  </div>
</footer>
