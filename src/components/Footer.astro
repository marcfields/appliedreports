---
import { site } from "../site";

const { footer } = site;
const siteHref = site.url;
const emailHref = `mailto:${site.contactEmail}`;
---

<footer class="footer">
  <img
    src={site.images.footer}
    alt=""
    class="footer__photo"
    width={1440}
    height={787}
    loading="lazy"
  />

  <div class="footer__content">
    <img
      src={site.logos.arc}
      alt={site.name}
      class="footer__logo"
      width={1106}
      height={134}
      loading="lazy"
    />

    <nav class="footer__links table-header" aria-label="Footer">
      <div>
        <a
          href={siteHref}
          class="transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
        >
          {footer.siteLabel}
        </a>
      </div>
      <div>
        <a
          href={emailHref}
          class="transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-field"
        >
          {footer.emailLabel}
        </a>
      </div>
      <div>
        <p>
          <span aria-hidden="true">© </span>
          {site.year}
          {" "}
          {footer.copyrightName}
        </p>
      </div>
    </nav>
  </div>
</footer>
