---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
import SiteHeader from "./SiteHeader.astro";

const [heroLineOne, heroLineTwo] = site.heroHeadline;
---

<section class="relative min-h-dvh overflow-hidden bg-field" aria-labelledby="hero-heading">
  <img
    src={site.images.heroOverlay}
    alt=""
    class="pointer-events-none absolute inset-0 size-full object-cover object-bottom opacity-50"
    width={1920}
    height={1080}
    loading="eager"
    decoding="async"
  />

  <div class="relative z-10 mx-auto flex min-h-dvh max-w-[90rem] flex-col px-6 pb-16 pt-8 sm:px-10 sm:pb-20 sm:pt-10 lg:px-[6.5rem]">
    <SiteHeader />

    <div class="mt-10 flex flex-1 flex-col justify-center py-16 lg:py-30">
      <p class="max-w-[40rem] font-sans text-2xl font-normal leading-[1.58] text-[#0E5BD6]">
        {site.heroKicker}
      </p>

      <div class="mt-8 flex w-full flex-col items-start gap-8">
        <h1
          id="hero-heading"
          class="flex w-full flex-col gap-1 font-display text-[clamp(2.75rem,7vw,5.5rem)] font-bold leading-[1.05] tracking-[-0.04em] text-type sm:gap-1.5"
        >
          <span>{heroLineOne}</span>
          <span>{heroLineTwo}</span>
        </h1>
        <p class="max-w-[40rem] font-sans text-2xl font-normal leading-[1.58] text-type">
          {site.heroSubcopy}
        </p>
      </div>

      <div class="mt-12">
        <CtaButton
          href={site.cta.primary.href}
          label={site.cta.primary.label}
          newTab={site.cta.primary.newTab}
        />
      </div>
    </div>
  </div>
</section>
