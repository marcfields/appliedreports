---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";
import SiteHeader from "./SiteHeader.astro";

const [heroLineOne, heroLineTwo] = site.heroHeadline;
---

<SectionPanel panelClass="relative min-h-dvh overflow-hidden bg-field" aria-labelledby="hero-heading">
  <img
    src={site.images.heroOverlay}
    alt=""
    class="pointer-events-none absolute inset-0 size-full object-cover object-bottom opacity-50"
    width={1920}
    height={1080}
    loading="eager"
    decoding="async"
  />

  <SectionShell class="relative z-10 flex min-h-dvh flex-col">
    <SiteHeader />

    <div class="mt-10 flex flex-col items-center text-center sm:mt-12 lg:mt-14">
      <p class="hero-kicker max-w-[40rem]">
        {site.heroKicker}
      </p>

      <div class="mt-8 flex w-full max-w-[40rem] flex-col items-center gap-8">
        <h1
          id="hero-heading"
          class="hero-h1 flex flex-col items-center gap-1 text-type sm:gap-1.5"
        >
          <span>{heroLineOne}</span>
          <span>{heroLineTwo}</span>
        </h1>
        <p class="hero-subcopy text-type">
          {site.heroSubcopy}
        </p>
      </div>

      <div class="mt-12">
        <CtaButton
          href={site.cta.primary.href}
          label={site.cta.primary.label}
          newTab={site.cta.primary.newTab}
        />
      </div>
    </div>
  </SectionShell>
</SectionPanel>
