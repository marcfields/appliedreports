---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
import SectionPanel from "./SectionPanel.astro";
import SiteHeader from "./SiteHeader.astro";

const [heroLineOne, heroLineTwo] = site.heroHeadline;
---

<SectionPanel panelClass="hero" aria-labelledby="hero-heading">
  <img
    src={site.images.heroOverlay}
    alt=""
    class="hero__bg hero__bg--desktop"
    width={site.images.heroOverlayWidth}
    height={site.images.heroOverlayHeight}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__bg-mobile" aria-hidden="true">
    <img
      src={site.images.heroOverlayMobile}
      alt=""
      class="hero__bg hero__bg--mobile"
      width={site.images.heroOverlayMobileWidth}
      height={site.images.heroOverlayMobileHeight}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero__content">
    <SiteHeader />
    <div class="hero-header-spacer" aria-hidden="true"></div>

    <div class="hero-shell">
      <div class="hero-copy">
        <p class="hero-kicker max-w-[40rem]">
          {site.heroKicker}
        </p>

        <div class="hero-copy__headline-block">
          <h1
            id="hero-heading"
            class="hero-h1 flex w-full max-w-full flex-col items-center gap-1 text-type sm:gap-1.5"
          >
            <span>{heroLineOne}</span>
            <span>{heroLineTwo}</span>
          </h1>
          <p class="hero-subcopy text-type">
            {site.heroSubcopy}
          </p>
        </div>

        <div class="hero-copy__cta">
          <CtaButton
            href={site.cta.primary.href}
            label={site.cta.primary.label}
            newTab={site.cta.primary.newTab}
          />
        </div>
      </div>
    </div>
  </div>
</SectionPanel>
