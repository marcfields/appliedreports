---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
import SiteHeader from "./SiteHeader.astro";
---

<section class="relative min-h-dvh overflow-hidden bg-field" aria-labelledby="hero-heading">
  <img
    src={site.images.heroOverlay}
    alt=""
    class="pointer-events-none absolute inset-0 size-full object-cover opacity-20"
    width={1920}
    height={1080}
    loading="eager"
    decoding="async"
  />

  <div class="relative z-10 mx-auto flex min-h-dvh max-w-[90rem] flex-col px-6 pb-16 pt-8 sm:px-10 sm:pb-20 sm:pt-10 lg:px-[6.5rem]">
    <SiteHeader />

    <div class="flex flex-1 flex-col items-center justify-center py-12 text-center">
      <p class="mb-6 font-sans text-[1.35rem] font-semibold leading-normal text-[#3c6f91] sm:text-[1.5625rem]">
        {site.heroKicker}
      </p>
      <h1
        id="hero-heading"
        class="max-w-[64rem] font-display text-[clamp(2.5rem,8vw,6.25rem)] font-bold leading-normal tracking-tight text-type"
      >
        {site.heroLine}
      </h1>
      <p
        class="mt-10 max-w-[67rem] font-sans text-[clamp(1.125rem,2.5vw,1.875rem)] font-semibold leading-[1.4] text-type lg:text-[1.875rem]"
      >
        {site.heroSubcopy}
      </p>
      <div class="mt-14">
        <CtaButton
          href={site.cta.primary.href}
          label={site.cta.primary.label}
          newTab={site.cta.primary.newTab}
        />
      </div>
    </div>
  </div>
</section>
