---
import { site } from "../site";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";

const { ottoIntro } = site;
---

<SectionPanel
  id="otto"
  class="scroll-mt-6"
  panelClass="bg-tone text-type"
  aria-labelledby="otto-intro-heading"
>
  <SectionShell>
    <h2 id="otto-intro-heading" class="heading-h2 text-type whitespace-pre-line">
      {ottoIntro.heading}
    </h2>
    <hr class="section-divider" />
    <p class="section-lead text-type">
      {ottoIntro.body}
    </p>

    <div class="section-steps">
      {
        site.productSteps.map((step) => (
          <article
            class:list={[
              "process-step",
              step.iconPosition === "right" && "lg:[&>div:first-child]:order-2",
            ]}
          >
            <div
              class:list={[
                "flex w-full justify-center",
                step.iconPosition === "right" ? "lg:justify-end" : "lg:justify-start",
              ]}
            >
              <div class="media-frame aspect-square w-full max-w-[28rem]">
                <img
                  src={step.icon}
                  alt=""
                  class="media-frame__img"
                  width={448}
                  height={448}
                  loading="lazy"
                />
              </div>
            </div>
            <div class="process-step__copy">
              <h3 class="heading-h3 text-type">
                <span class="text-mark">{step.id}</span>
                <span> {step.title}</span>
              </h3>
              <p class="heading-h4 text-type">
                {step.summary}
              </p>
              <p class="table-body text-type">
                {step.body}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </SectionShell>
</SectionPanel>
