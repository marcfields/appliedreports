---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";

const { demoBanner } = site;
---

<SectionPanel
  panelClass="relative min-h-[30rem] overflow-hidden"
  aria-labelledby="demo-banner-heading"
>
  <img
    src={demoBanner.image}
    alt=""
    class="absolute inset-0 size-full object-cover object-[26%_18%]"
    width={1732}
    height={481}
    loading="lazy"
  />
  <div class="absolute inset-0 bg-type/30" aria-hidden="true" />

  <SectionShell class="demo-banner__shell relative z-10">
    <h2 id="demo-banner-heading" class="heading-h2 max-w-[52rem] text-paper whitespace-pre-line">
      {demoBanner.heading}
    </h2>
    <div class="demo-banner__cta">
      <CtaButton
        href={site.cta.primary.href}
        label={site.cta.primary.label}
        variant="field"
        newTab={site.cta.primary.newTab}
      />
    </div>
  </SectionShell>
</SectionPanel>
