---
import { site } from "../site";
import CtaButton from "./CtaButton.astro";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";

const { demoBanner } = site;
---

<SectionPanel panelClass="relative min-h-[30rem] overflow-hidden" aria-labelledby="demo-banner-heading">
  <img
    src={demoBanner.image}
    alt=""
    class="absolute inset-0 size-full object-cover object-[26%_18%]"
    width={1732}
    height={481}
    loading="lazy"
  />
  <div class="absolute inset-0 bg-type/30" aria-hidden="true" />

  <SectionShell class="relative z-10 flex min-h-[30rem] flex-col justify-center">
    <h2 id="demo-banner-heading" class="heading-h2 max-w-[76rem] text-paper whitespace-pre-line">
      {demoBanner.heading}
    </h2>
    <div class="mt-12">
      <CtaButton
        href={site.cta.primary.href}
        label={site.cta.primary.label}
        variant="field"
        newTab={site.cta.primary.newTab}
      />
    </div>
  </SectionShell>
</SectionPanel>
