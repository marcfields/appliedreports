---
import { site } from "../site";

const firmSizes = [
  { value: "1-50", label: "1–50" },
  { value: "51-200", label: "51–200" },
  { value: "201-500", label: "201–500" },
  { value: "500+", label: "500+" },
] as const;

const { heightPx, minWidthPx, fontSizePx } = site.ctaButton;

const inputClass =
  "mt-2 w-full rounded-md border border-type/15 bg-field px-4 py-3 font-sans text-sm text-type outline-none transition placeholder:text-type/35 focus:border-type/40 focus:ring-2 focus:ring-type/10";
const labelClass = "block text-left font-sans text-sm font-medium text-type";
---

<section
  id="book-demo"
  class="scroll-mt-6 border-t border-type/10 bg-field"
  aria-labelledby="book-demo-heading"
>
  <div class="mx-auto max-w-lg px-6 py-20 sm:px-10 sm:py-24">
    <h2
      id="book-demo-heading"
      class="text-center font-display text-3xl font-bold leading-snug tracking-tight text-type sm:text-4xl"
    >
      {site.demoForm.heading}
    </h2>

    <form id="book-demo-form" class="mt-12 space-y-6">
      <div>
        <label class={labelClass} for="demo-name">Name <span class="text-mark">*</span></label>
        <input
          id="demo-name"
          type="text"
          name="name"
          required
          autocomplete="name"
          class={inputClass}
          placeholder="e.g. Jane Smith"
        />
      </div>
      <div>
        <label class={labelClass} for="demo-firm">Firm name <span class="text-mark">*</span></label>
        <input
          id="demo-firm"
          type="text"
          name="firmName"
          required
          autocomplete="organization"
          class={inputClass}
          placeholder="e.g. Example Associates"
        />
      </div>
      <div>
        <label class={labelClass} for="demo-email">
          Business email <span class="text-mark">*</span>
        </label>
        <input
          id="demo-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          class={inputClass}
          placeholder="e.g. jane@firm.com"
        />
      </div>
      <div>
        <label class={labelClass} for="demo-size">Firm size <span class="text-mark">*</span></label>
        <div class="relative mt-2">
          <select id="demo-size" name="firmSize" required class:list={[inputClass, "mt-0 appearance-none pr-10"]}>
            <option value="" disabled selected>Select one…</option>
            {
              firmSizes.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))
            }
          </select>
          <span
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-type/50"
            aria-hidden="true">▾</span
          >
        </div>
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-[5px] bg-mark font-sans font-bold leading-none text-paper transition hover:bg-mark/90"
          style={`height:${heightPx}px;min-width:${minWidthPx}px;font-size:${fontSizePx}px;padding-left:1.25rem;padding-right:1.25rem;`}
        >
          {site.demoForm.submitLabel}
        </button>
        <p class="text-right text-xs text-type/50">
          <span class="text-mark">*</span>Required
        </p>
      </div>
    </form>
  </div>
</section>

<script
  define:vars={{
    contactEmail: site.contactEmail,
    subject: "Book a demo",
  }}
>
  const form = document.getElementById("book-demo-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const el = e.target;
    if (!(el instanceof HTMLFormElement)) return;
    const data = new FormData(el);
    const lines = [
      `Name: ${data.get("name") ?? ""}`,
      `Firm name: ${data.get("firmName") ?? ""}`,
      `Business email: ${data.get("email") ?? ""}`,
      `Firm size: ${data.get("firmSize") ?? ""}`,
    ];
    const body = lines.join("\n");
    window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
