---
interface Props {
  /** Background / theme classes on the inset panel (e.g. `bg-paper text-type`). */
  panelClass?: string;
  class?: string;
  id?: string;
  "aria-labelledby"?: string;
}

const { panelClass, class: className, id, "aria-labelledby": ariaLabelledby } = Astro.props;
---

<section
  class:list={["w-full", panelClass, className]}
  id={id}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</section>
