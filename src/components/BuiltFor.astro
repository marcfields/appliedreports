---
import { site } from "../site";
import SectionPanel from "./SectionPanel.astro";
import SectionShell from "./SectionShell.astro";

const { builtFor } = site;
---

<SectionPanel panelClass="bg-field text-type" aria-labelledby="built-for-heading">
  <SectionShell>
    <h2 id="built-for-heading" class="heading-h2 text-type">
      {builtFor.heading}
    </h2>
    <hr class="section-divider" />

    <ul class="section-content feature-grid">
      {
        builtFor.items.map((item) => (
          <li class="feature-card">
            <img
              src={item.icon}
              alt=""
              class="size-[9.375rem] object-contain"
              width={150}
              height={150}
              loading="lazy"
            />
            <h3 class="heading-h4 text-type">
              {item.title}
            </h3>
            <p class="table-body text-type whitespace-pre-line">
              {item.body}
            </p>
          </li>
        ))
      }
    </ul>
  </SectionShell>
</SectionPanel>
