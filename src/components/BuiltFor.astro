---
import { site } from "../site";

const { builtFor } = site;
---

<section class="bg-field" aria-labelledby="built-for-heading">
  <div class="mx-auto max-w-[87rem] px-6 py-16 sm:px-10 sm:py-20 lg:px-[6.5rem] lg:py-24">
    <h2
      id="built-for-heading"
      class="font-display text-[clamp(2rem,5vw,3.75rem)] font-bold leading-[1.4] text-type"
    >
      {builtFor.heading}
    </h2>
    <hr class="mt-8 border-0 border-t border-type/15" />

    <ul class="mt-16 grid gap-12 sm:grid-cols-3 sm:gap-8">
      {
        builtFor.items.map((item) => (
          <li class="flex flex-col items-center text-center">
            <img
              src={item.icon}
              alt=""
              class="size-[7.7rem] object-contain"
              width={123}
              height={123}
              loading="lazy"
            />
            <h3 class="mt-8 font-sans text-[1.375rem] font-bold leading-[1.4] text-type">
              {item.title}
            </h3>
            <p class="mt-4 font-sans text-lg leading-[1.4] text-type whitespace-pre-line">
              {item.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
